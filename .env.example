# ---- Docker Compose deployment settings. Copy to .env before `docker compose up`. ----

ENVIRONMENT=production

# REQUIRED. Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# PostgreSQL credentials
POSTGRES_USER=tourist
POSTGRES_PASSWORD=change_this_strong_password
POSTGRES_DB=tourist_safety

# Where the frontend is served (used for CORS)
FRONTEND_PORT=8080
CORS_ORIGINS=http://localhost:8080

# Trusted Host header(s). Set to your domain in real deployments, e.g. example.com
ALLOWED_HOSTS=*

# Seed demo data on first boot (set false once you have real data)
SEED_ON_START=true
