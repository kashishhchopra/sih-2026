# Copy to .env for local overrides. All optional — sensible defaults are built in.

# API base path (kept relative so the nginx/vite proxy handles routing).
VITE_API_BASE=/api
VITE_WS_PATH=/ws/alerts

# Show the one-click demo login buttons (set false for production).
VITE_SHOW_DEMO=true
# Demo credentials shown as one-click buttons on the login screen -- deploy
# config, not source, and empty by default so a production build never ships
# a working login baked into the bundle. JSON array of {label,email,password}.
# Example for local dev (matches backend/app/scripts/seed.py defaults):
# VITE_DEMO_LOGINS=[{"label":"Police / Admin","email":"admin@tourism.gov.in","password":"admin123"},{"label":"Tourist (Aarav)","email":"aarav@example.com","password":"tourist123"}]
VITE_DEMO_LOGINS=

# Polling / tracking cadence (ms)
VITE_POLL_INTERVAL_MS=8000
VITE_TRACK_INTERVAL_MS=5000

# Map defaults (also served by the backend /api/config)
VITE_MAP_CENTER_LAT=26.1445
VITE_MAP_CENTER_LNG=91.7362
VITE_MAP_ZOOM=13
