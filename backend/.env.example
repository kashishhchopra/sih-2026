# ---- Copy to .env and adjust. NEVER commit the real .env. ----

# development | production  (production enforces a strong SECRET_KEY & hides docs)
ENVIRONMENT=development

# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
# REQUIRED in production. Leave blank in dev to auto-generate an ephemeral key.
SECRET_KEY=

# SQLite for dev; PostgreSQL for prod, e.g.
#   postgresql+psycopg://user:password@db:5432/tourist_safety
DATABASE_URL=sqlite:///./tourist_safety.db

# JWT lifetimes (minutes). Access is deliberately short -- see
# app/api/auth.py for why refresh tokens carry revocation instead.
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_MINUTES=10080

# Refresh token is set as an httpOnly cookie (never JS-readable). Secure
# should be true behind HTTPS -- i.e. always in a real deployment.
REFRESH_COOKIE_SECURE=false
REFRESH_COOKIE_SAMESITE=strict

# Scheduler / cross-worker job locking (see app/core/joblock.py)
SCHEDULER_ENABLED=true
JOB_LOCK_TTL_SECONDS=120
TOKEN_PURGE_TICK_SECONDS=3600

# Demo account passwords for `python -m app.scripts.seed`. Leave unset to
# get a random password printed once. The script refuses to run against
# ENVIRONMENT=production unless SEED_FORCE=true.
SEED_ADMIN_PASSWORD=
SEED_TOURIST_PASSWORD=
SEED_RESPONDER_PASSWORD=
SEED_FORCE=false

# Outbound notifications (password-reset codes, SOS alerts to emergency
# contacts). "console" logs instead of sending -- no external service
# needed. See app/services/notifications.py to add a real backend.
NOTIFICATION_CHANNEL=console
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30

# Comma-separated allowed CORS origins (the frontend URLs)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Comma-separated trusted Host headers. Use explicit hosts in production, e.g.
#   api.example.com,example.com   ('*' disables the check — dev only)
ALLOWED_HOSTS=*

# Rate limiting
RATE_LIMIT_ENABLED=true
LOGIN_RATE_LIMIT=10
LOGIN_RATE_WINDOW_SECONDS=300
GLOBAL_RATE_LIMIT=240
GLOBAL_RATE_WINDOW_SECONDS=60

# Password policy
MIN_PASSWORD_LENGTH=8

# Domain thresholds
ROUTE_DEVIATION_THRESHOLD_M=2000
ANOMALY_INCIDENT_DEDUPE_MINUTES=5

# Map defaults surfaced to the frontend via /api/config
MAP_CENTER_LAT=26.1445
MAP_CENTER_LNG=91.7362
MAP_DEFAULT_ZOOM=13

# ML artifacts
ML_MODELS_DIR=ml_models

# Weather: the safety-score input (services/weather.py) AND the real-time
# Disaster & Weather Alert Feed's weather-condition hazard detector
# (services/disaster.py::weather_condition_advisories -- extreme heat/cold,
# thunderstorm, heavy rain, dense fog, derived from actual current
# conditions at each zone). Leave blank to use a deterministic mock for the
# safety score and to skip weather-condition advisories entirely (no
# network needed -- the default, and what keeps an offline demo working).
# Get a free key at https://openweathermap.org/api
OPENWEATHER_API_KEY=

# Public holidays (Smart Trip Planner, Crowd & Queue Forecast, Festival &
# Local Event Intelligence): the Calendarific API (https://calendarific.com).
# Free tier, but a signup + key is required (Nager.Date, which needs no key
# at all, does not cover India). Leave blank and this signal is simply
# absent everywhere it's used -- never a fabricated holiday.
# Get a free key at https://calendarific.com/signup
CALENDARIFIC_API_KEY=
HOLIDAYS_COUNTRY_CODE=IN

# Discovery (hidden spots / regional food / homestays): live lookups from
# the free public OpenStreetMap Overpass API -- no key/signup required.
# Set to false to serve database-only results (e.g. a fully offline demo
# venue with no outbound network access at all).
DISCOVERY_LIVE_ENABLED=true
OVERPASS_API_URL=https://overpass-api.de/api/interpreter

# External services: maps / translation / speech. All optional -- every
# feature built on these (route ETA, place search, phrase translation,
# text-to-speech) has a deterministic demo/mock fallback and works with
# none of these set. See app/services/maps.py and app/services/translation.py.
#   Google Maps Platform (Directions/Places/Distance Matrix):
#     https://console.cloud.google.com/google/maps-apis
GOOGLE_MAPS_API_KEY=
#   Google Cloud Translation API: https://cloud.google.com/translate
GOOGLE_TRANSLATE_API_KEY=
#   Any cloud speech-to-text provider. Left blank, the frontend's own
#   browser-native Web Speech API is used instead (see
#   frontend/src/hooks/useSpeechRecognition.js) -- no backend call needed.
SPEECH_TO_TEXT_API_KEY=
#   Any cloud text-to-speech provider. Left blank, the frontend's own
#   browser-native SpeechSynthesis API is used instead.
TEXT_TO_SPEECH_API_KEY=

# ---- open-ended assistant (see app/services/llm.py) ----
# Safety-critical questions ("nearest hospital") are always answered from
# real database rows by the intent router. This backs EVERYTHING ELSE, so
# the assistant can answer any question instead of a fixed command list.
# Default "auto": a cloud key below if one is set, otherwise a local Ollama
# model, otherwise the assistant just says what it can do.
LLM_ENABLED=true
# auto | ollama | openai | anthropic | none
LLM_PROVIDER=auto
LLM_TIMEOUT_SECONDS=30
LLM_MAX_TOKENS=250
LLM_TEMPERATURE=0.3
#   Local model -- free, no API key, nothing leaves the machine.
#   Install: https://ollama.com  then:  ollama pull llama3.2 && ollama serve
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
#   Optional cloud models -- better answers, but cost money and send the
#   question (plus the tourist's context) to a third party.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Live-feed fallback ladder (see app/services/feeds.py). False = snapshot-
# only, no network calls at all -- useful at a venue with no reliable internet.
FEEDS_ENABLED=true

# Disaster advisory feed: "" (default) runs the built-in deterministic
# simulator. "cap" polls DISASTER_FEED_URL for a real CAP 1.2 feed (see
# app/services/cap.py) and falls back to the simulator if it's unreachable.
DISASTER_FEED_PROVIDER=
DISASTER_FEED_URL=

# ---- CCTV network (services/cctv.py) ----
# Leave CCTV_PROVIDER empty (default) to use the database as the only source
# of cameras: an operator registers each one, with its real stream URL,
# through POST /api/police-network/cameras. Nothing is ever auto-populated
# with invented cameras -- with no cameras registered, /api/cctv returns an
# empty list and the dashboard says there are no feeds available.
#
# Set CCTV_PROVIDER=json plus CCTV_PROVIDER_URL to additionally import
# camera metadata from an external open-data/public-camera feed that returns
# a JSON list of {name, latitude, longitude, streamUrl}. Any credential the
# feed needs stays here, server-side -- never in frontend code.
CCTV_PROVIDER=
CCTV_PROVIDER_URL=
CCTV_API_KEY=
# Bounds on the live-status probe and how long its result is reused.
CCTV_PROBE_TIMEOUT_SECONDS=4.0
CCTV_STATUS_CACHE_SECONDS=30
# How often the dashboard re-polls camera status, in seconds.
CCTV_REFRESH_INTERVAL_SECONDS=30
